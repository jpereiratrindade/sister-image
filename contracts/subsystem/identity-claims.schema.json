{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/subsystem/1.0.0/identity-claims.schema.json",
  "title": "SisTer Internal Identity Claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["iss", "sub", "aud", "capabilities", "purpose", "iat", "exp", "jti", "request_id"],
  "properties": {
    "iss": {"const": "sisterd"},
    "sub": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"},
    "aud": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"}
    },
    "purpose": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"},
    "iat": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 0},
    "jti": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,119}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"}
  }
}
