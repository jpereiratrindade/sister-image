{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/participant/2.0.0/capability.schema.json",
  "title": "SisTer Capability Draft",
  "description": "DRAFT / NOT RUNTIME-NORMATIVE semantic capability definition.",
  "x-sister-contract-status": "DRAFT",
  "x-sister-runtime-normative": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "purpose",
    "input_contract",
    "output_contract",
    "decision_authority",
    "side_effect",
    "evidence_requirements"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,5}$"
    },
    "version": {"$ref": "#/$defs/semantic-version"},
    "purpose": {"type": "string", "minLength": 8, "maxLength": 500},
    "input_contract": {"$ref": "#/$defs/contract-reference"},
    "output_contract": {"$ref": "#/$defs/contract-reference"},
    "decision_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "owner"],
      "properties": {
        "scope": {"type": "string", "minLength": 3, "maxLength": 160},
        "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
      }
    },
    "side_effect": {
      "enum": ["none", "participant_state_change", "external_effect"]
    },
    "preconditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 240},
      "uniqueItems": true
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 240},
      "uniqueItems": true
    }
  },
  "$defs": {
    "semantic-version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "contract-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "version": {"$ref": "#/$defs/semantic-version"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
