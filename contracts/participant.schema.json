{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/participant/2.0.0/participant.schema.json",
  "title": "SisTer Participant Draft",
  "description": "DRAFT / NOT RUNTIME-NORMATIVE transport-independent participant definition.",
  "x-sister-contract-status": "DRAFT",
  "x-sister-runtime-normative": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_status",
    "runtime_normative",
    "participant_id",
    "name",
    "version",
    "owner",
    "identity",
    "authority_scopes",
    "capabilities",
    "relation_roles",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "sister.participant/2.0.0"},
    "contract_status": {"const": "DRAFT"},
    "runtime_normative": {"const": false},
    "participant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "owner": {"type": "string", "minLength": 2, "maxLength": 160},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "declared_by"],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "declared_by": {"type": "string", "minLength": 2, "maxLength": 160}
      }
    },
    "authority_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "responsibility", "decision_owner"],
        "properties": {
          "scope": {"type": "string", "minLength": 3, "maxLength": 160},
          "responsibility": {"type": "string", "minLength": 8, "maxLength": 500},
          "decision_owner": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "capability.schema.json"}
    },
    "relation_roles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,79}$"},
      "uniqueItems": true
    },
    "state_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state_id", "meaning", "declared_by"],
        "properties": {
          "state_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,79}$"},
          "meaning": {"type": "string", "minLength": 3, "maxLength": 300},
          "declared_by": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "declared_at"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 3, "maxLength": 500},
        "declared_at": {"type": "string", "format": "date-time"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
